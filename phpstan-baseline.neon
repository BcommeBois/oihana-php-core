parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$format of method DateTimeImmutable\:\:format\(\) expects string, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/oihana/core/date/formatDateTime.php

		-
			message: '#^Call to function is_callable\(\) with callable\(\)\: mixed will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/oihana/core/helpers/conditions.php

		-
			message: '#^Parameter \#2 \$haystack of function in_array expects array, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/oihana/core/isLiteral.php

		-
			message: '#^Function oihana\\core\\maths\\ceilValue\(\) never returns int so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/oihana/core/maths/ceilValue.php

		-
			message: '#^Function oihana\\core\\maths\\floorValue\(\) never returns int so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/oihana/core/maths/floorValue.php

		-
			message: '#^Offset ''angle'' on array\{angle\: float, radius\: float\} in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 1
			path: src/oihana/core/maths/polarToCartesian.php

		-
			message: '#^Offset ''angle'' on array\{angle\: float, radius\: float\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/oihana/core/maths/polarToCartesian.php

		-
			message: '#^Offset ''radius'' on array\{angle\: float, radius\: float\} in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 1
			path: src/oihana/core/maths/polarToCartesian.php

		-
			message: '#^Offset ''radius'' on array\{angle\: float, radius\: float\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/oihana/core/maths/polarToCartesian.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 1
			path: src/oihana/core/maths/polarToCartesian.php

		-
			message: '#^Result of \|\| is always false\.$#'
			identifier: booleanOr.alwaysFalse
			count: 1
			path: src/oihana/core/maths/polarToCartesian.php

		-
			message: '#^Function oihana\\core\\maths\\roundValue\(\) never returns int so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/oihana/core/maths/roundValue.php

		-
			message: '#^Function oihana\\core\\objects\\set\(\) should return object but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/oihana/core/objects/set.php

		-
			message: '#^Parameter \#1 \$object_or_class of function property_exists expects object\|string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/oihana/core/objects/set.php

		-
			message: '#^Parameter \#1 \$separator of function explode expects non\-empty\-string, string given\.$#'
			identifier: argument.type
			count: 1
			path: src/oihana/core/objects/set.php

		-
			message: '#^Function oihana\\core\\objects\\toAssociativeArray\(\) should return array\<string, mixed\> but returns array\<mixed\>\.$#'
			identifier: return.type
			count: 1
			path: src/oihana/core/objects/toAssociativeArray.php

		-
			message: '#^Function oihana\\core\\objects\\toAssociativeArray\(\) should return array\<string, mixed\> but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/oihana/core/objects/toAssociativeArray.php

		-
			message: '#^Parameter \#1 \$json of function json_decode expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/oihana/core/objects/toAssociativeArray.php

		-
			message: '#^Parameter \#2 \$array of function array_map expects array, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/oihana/core/objects/toAssociativeArray.php

		-
			message: '#^Strict comparison using \=\=\= between 2 and 2 will always evaluate to true\.$#'
			identifier: identical.alwaysTrue
			count: 1
			path: src/oihana/core/reflections/getFunctionInfo.php
